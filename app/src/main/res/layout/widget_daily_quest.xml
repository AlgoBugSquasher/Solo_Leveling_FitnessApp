<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_obsidian"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header: Title and Streak -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DAILY QUEST"
            android:textColor="#E0E0E0"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="🔥 0 DAYS"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="#4A4A50"
        android:contentDescription="@null" />

    <!-- Middle: Quest Rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Exercise 1 -->
        <TextView
            android:id="@+id/widget_label_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PUSH-UPS [ 0 / 20 ]"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_progress_1"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:progressTint="#E0E0E0" />

        <!-- Exercise 2 -->
        <TextView
            android:id="@+id/widget_label_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PULL-UPS [ 0 / 10 ]"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_progress_2"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:progressTint="#E0E0E0" />

        <!-- Exercise 3 -->
        <TextView
            android:id="@+id/widget_label_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLANK [ 0 / 60 ]"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
        <ProgressBar
            android:id="@+id/widget_progress_3"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:progressTint="#E0E0E0" />

    </LinearLayout>

    <!-- Bottom: Status Badge -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_widget_status_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="🚨 INCOMPLETE"
        android:textColor="#FF3131"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
